{:paths ["src"]

 ;; The private registry. Declared HERE, not only in a developer's user-level
 ;; deps.edn, so a cold clone and CI resolve hive-agi artifacts identically.
 ;; Credentials come from ~/.m2/settings.xml (server id "hive-gitea").
 :mvn/repos {"hive-gitea" {:url "https://gitea.hive-mcp.com/api/packages/hive-agi/maven"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}

        ;; datahike — temporal Datalog store (konserve/persistent-sorted-set
        ;; pulled transitively).
        org.replikativ/datahike {:mvn/version "0.8.1788"}

        ;; konserve — pinned to the per-key-lock refcount-reclaim release
        ;; (bounds datahike's :locks channel heap residency).
        org.replikativ/konserve {:mvn/version "0.9.375"}

        ;; hive-spi — IKGStore / IPersistentKGStore / ITemporalKGStore contracts.
        io.github.hive-agi/hive-spi {:mvn/version "0.1.20"}

        ;; hive-dsl — Result/rescue DSL. hive-weave — retry/with-recovery auto-heal.
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.16"}
        io.github.hive-agi/hive-weave {:mvn/version "0.3.2"}

        com.taoensso/timbre {:mvn/version "6.8.0"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  :build
  {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.10"}}
   :ns-default hive-build.api}}}
